# Supabase — shared web+mobile project (wrbauxutkysljmsqojts)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sanity — reuse the mobile app's project/dataset
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=

# PostHog — product analytics (shared project with mobile; events tagged platform: "web")
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# i18n — Arabic (RTL) and Canadian French are ON by default, matching the mobile
# app. Set either to "false" to hide that language from the picker again
# (kill-switch). Punjabi is the opposite: OFF by default, pending native
# review of its Sanity content — set to "true" to surface it locally. Leave
# unset/empty otherwise.
NEXT_PUBLIC_ENABLE_ARABIC=
NEXT_PUBLIC_ENABLE_FRENCH=
NEXT_PUBLIC_ENABLE_PUNJABI=

# Sentry — error monitoring / tracing. DSNs are public (not secrets); use the
# same value for both. NEXT_PUBLIC_SENTRY_DSN is required for browser capture.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Build-time source-map upload token (secret). Keep in .env.sentry-build-plugin
# or CI secrets — never commit a value.
SENTRY_AUTH_TOKEN=

# Daily Sentry → PostHog snapshot cron (app/api/cron/sentry-snapshot, scheduled
# in vercel.json). All set in Vercel, not committed. The cron is inert until
# these exist.
#  - SENTRY_API_TOKEN: Sentry auth token scoped org:read + project:read +
#    event:read (distinct from the build-time SENTRY_AUTH_TOKEN above).
#  - POSTHOG_PROJECT_API_KEY: PostHog project key (phc_…) for server-side capture.
#  - CRON_SECRET: injected by Vercel Cron; the route rejects any other caller.
SENTRY_API_TOKEN=
POSTHOG_PROJECT_API_KEY=
CRON_SECRET=
